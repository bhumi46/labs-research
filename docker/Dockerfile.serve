# ─── Base selection ───────────────────────────────────────────────────────────
# Build for CPU (default):  docker build -t house-price-predictor:cpu .
# Build for GPU:            docker build --build-arg VARIANT=gpu -t house-price-predictor:gpu .
ARG VARIANT=cpu

# ─── CPU base ─────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS base-cpu

# ─── GPU base ─────────────────────────────────────────────────────────────────
# CUDA 12.1 + cuDNN 8 runtime on Ubuntu 22.04 (NVIDIA official image)
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04 AS base-gpu
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip

# ─── Stage 1: Builder ─────────────────────────────────────────────────────────
# Selects base-cpu or base-gpu depending on VARIANT arg
FROM base-${VARIANT} AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
# Install only runtime deps (not dev deps like pytest)
RUN pip install --no-cache-dir --user -e "."

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
# Re-select the same base for the final lean image
FROM base-${VARIANT} AS runtime

WORKDIR /app

# Copy installed packages from the builder stage
COPY --from=builder /root/.local /root/.local

# Copy only the application code needed for serving
COPY serve/ serve/
COPY src/ src/
COPY pyproject.toml .

ENV PATH="/root/.local/bin:$PATH"
ENV PYTHONPATH="/app"

# These are overridden by docker-compose.yml or Kubernetes env vars
ENV MLFLOW_TRACKING_URI="http://mlflow:5000"
ENV MLFLOW_MODEL_NAME="house-price-model"
ENV MLFLOW_MODEL_STAGE="Production"

EXPOSE 8000

# Kubernetes uses this to decide if the pod is healthy
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "serve.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
